;;;; scripts/gen-docs.lisp - generate the enumerable parts of the documentation.
;;;;
;;;; Usage (writes docs/using/tools.md and docs/using/errors.md):
;;;;   sbcl --noinform --non-interactive --load scripts/gen-docs.lisp
;;;;
;;;; The tests load this file with CL-USER::*GEN-DOCS-NO-RUN* bound so that they can call
;;;; GENERATE-TOOLS-MD / GENERATE-ERRORS-MD and compare against the committed files.
;;;; Output is deterministic (no timestamps) so `git diff` shows real drift only.

(require :asdf)

(unless (find-package :cl-tron-mcp/tools)
  (let ((root (uiop:pathname-parent-directory-pathname
               (uiop:pathname-directory-pathname *load-truename*))))
    (pushnew root asdf:*central-registry* :test #'equal))
  (ql:quickload :cl-tron-mcp :silent t))

(defpackage :cl-tron-mcp/docgen
  (:use :cl)
  (:export #:generate-tools-md #:generate-errors-md #:write-docs #:project-root))

(in-package :cl-tron-mcp/docgen)

(defun project-root ()
  (asdf:system-source-directory :cl-tron-mcp))

(defparameter *categories*
  '(("repl" . "REPL (preferred, high-level)")
    ("swank" . "Swank (low-level) and managed processes")
    ("debugger" . "Debugger")
    ("breakpoint" . "Breakpoints")
    ("step" . "Stepping")
    ("inspect" . "Inspector")
    ("code" . "Hot reload")
    ("reload" . "Hot reload")
    ("profile" . "Profiler")
    ("trace" . "Tracer")
    ("thread" . "Threads")
    ("log" . "Logging")
    ("who" . "Cross-reference")
    ("list" . "Cross-reference")
    ("health" . "Monitoring")
    ("runtime" . "Monitoring")
    ("system" . "Monitoring")
    ("gc" . "Monitoring")
    ("whitelist" . "Security (approval whitelist)")
    ("skill" . "Skills and installation"))
  "Tool-name prefix -> category title. Unknown prefixes land in \"Other\".")

(defparameter *category-order*
  '("REPL (preferred, high-level)" "Swank (low-level) and managed processes" "Debugger"
    "Breakpoints" "Stepping" "Inspector" "Hot reload" "Profiler" "Tracer" "Threads" "Logging"
    "Cross-reference" "Monitoring" "Security (approval whitelist)" "Skills and installation"
    "Other"))

(defun tool-category (name)
  (let* ((us (position #\_ name))
         (prefix (if us (subseq name 0 us) name)))
    (or (cdr (assoc prefix *categories* :test #'string=)) "Other")))

(defun one-line (string &optional (max 160))
  "First sentence of STRING on one line, table-safe, at most MAX characters."
  (let* ((s (substitute #\Space #\Newline (or string "")))
         (s (substitute #\Space #\Tab s))
         (end (or (search ". " s) (and (plusp (length s)) (char= (char s (1- (length s))) #\.)
                                       (1- (length s)))
                  (length s)))
         (s (string-trim " " (subseq s 0 end))))
    (when (> (length s) max)
      (setf s (concatenate 'string (string-trim " " (subseq s 0 (- max 3))) "...")))
    (with-output-to-string (out)
      (loop for c across s
            do (if (char= c #\|) (write-string "\\|" out) (write-char c out))))))

(defun tool-page (name)
  "Relative link target docs/tools/<name>.md if that page exists, else NIL."
  (let ((file (format nil "~a.md" (substitute #\- #\_ name))))
    (when (probe-file (merge-pathnames (format nil "docs/tools/~a" file) (project-root)))
      file)))

(defun registered-tool-names ()
  (let (names)
    (maphash (lambda (k v) (declare (ignore v)) (push k names)) cl-tron-mcp/tools::*tool-registry*)
    (sort names #'string<)))

(defun generate-tools-md ()
  (let* ((names (registered-tool-names))
         (groups (make-hash-table :test 'equal)))
    (dolist (n names) (push n (gethash (tool-category n) groups)))
    (with-output-to-string (out)
      (format out "# Tool catalogue~%~%")
      (format out "<!-- GENERATED by scripts/gen-docs.lisp from the tool registry. Do not edit. -->~%~%")
      (format out "**~d tools.** For parameters and JSON schemas, call `tools/list`; it is the ~
canonical reference. Tools marked **user** need human approval (see [approval.md](approval.md)); ~
**none** run immediately. Prefer `repl_*` over `swank_*`.~%~%" (length names))
      (dolist (cat *category-order*)
        (let ((tools (reverse (gethash cat groups))))
          (when tools
            (format out "## ~a (~d)~%~%| Tool | Approval | What it does |~%|---|---|---|~%" cat (length tools))
            (dolist (n tools)
              (let* ((d (cl-tron-mcp/tools::get-tool-descriptor n))
                     (approval (if (cl-tron-mcp/tools::tool-requires-user-approval-p n) "user" "none"))
                     (page (tool-page n))
                     (label (if page (format nil "[`~a`](../tools/~a)" n page) (format nil "`~a`" n))))
                (format out "| ~a | ~a | ~a |~%" label approval
                        (one-line (and d (gethash :|description| d))))))
            (terpri out)))))))

(defun generate-errors-md ()
  (with-output-to-string (out)
    (format out "# Error codes~%~%")
    (format out "<!-- GENERATED by scripts/gen-docs.lisp from src/resources/error-codes.lisp. Do not edit. -->~%~%")
    (format out "Tool failures carry a `code`. Look it up here.~%~%")
    (format out "| Code | Meaning | Fix |~%|---|---|---|~%")
    (dolist (e (sort (copy-list cl-tron-mcp/resources::*error-codes*) #'string<
                     :key (lambda (e) (getf e :code))))
      (format out "| `~a` | ~a | ~a |~%" (getf e :code)
              (one-line (getf e :message) 200) (one-line (getf e :hint) 240)))))

(defun write-file (relative content)
  (let ((path (merge-pathnames relative (project-root))))
    (ensure-directories-exist path)
    (with-open-file (o path :direction :output :if-exists :supersede :external-format :utf-8)
      (write-string content o))
    (format t "wrote ~a~%" path)))

(defun write-docs ()
  (write-file "docs/using/tools.md" (generate-tools-md))
  (write-file "docs/using/errors.md" (generate-errors-md)))

(unless (boundp 'cl-user::*gen-docs-no-run*)
  (write-docs))
